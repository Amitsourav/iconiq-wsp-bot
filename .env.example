# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in.  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Admin panel login ------------------------------------------------------
ADMIN_USER=admin
# Use a real password. The bot refuses to start on known defaults.
ADMIN_PASS=
# Generate with:  openssl rand -hex 32
JWT_SECRET=

# --- Google Sheet -----------------------------------------------------------
# The part of the sheet URL between /d/ and /edit
GOOGLE_SHEET_ID=
# Tab name within the spreadsheet
GOOGLE_SHEET_TAB=Sheet1
GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# Sheet layout (row 2 = section labels, row 3 = headers, data starts row 4)
SHEET_SECTION_ROW=2
SHEET_HEADER_ROW=3
SHEET_DATA_START_ROW=4

# --- Server -----------------------------------------------------------------
PORT=3001
# 127.0.0.1 keeps the panel off the public internet. Use 0.0.0.0 only if the
# VM firewall restricts port access or you front it with a reverse proxy.
HOST=127.0.0.1

# --- Runtime ----------------------------------------------------------------
LOG_LEVEL=info
TZ_DISPLAY=Asia/Kolkata

# Ignore an identical message for the same phone seen again within N minutes.
DEDUPE_WINDOW_MINUTES=10

# --- Scheduled reports ------------------------------------------------------
# Morning summary of yesterday's leads plus today's follow-ups.
DAILY_SUMMARY_AT=09:00

# Daily Loan MIS — month-to-date leads, login, sanction and PF per counsellor,
# measured against a target. Replaced the same-day login-and-PF report, which
# showed a subset of these numbers in a second message every evening.
MIS_REPORT_AT=18:58
# Who is listed, by CRM email. STAGE_REPORT_AGENTS is still read as a fallback,
# so a deployment that set it for the old report keeps working.
MIS_REPORT_AGENTS=ankit@fundmycampus.com,hbhatia4216@gmail.com,zaid@fundmycampus.com,fundmycampus@gmail.com
# MONTHLY PF target per person. The CRM has no PF target field, so it lives here;
# the team target is this number times the number of counsellors reported.
PF_TARGET=10

# Push the day's DM chatbot conversations (name, phone, transcript) into the CRM
# as a lead + remark, so the team can read what was discussed without opening
# WhatsApp. Runs late so a still-ongoing chat gets synced whole, not in pieces.
DM_CRM_SYNC_AT=22:30

# --- AI replies (OpenRouter) -------------------------------------------------
# Covers DMs to the bot's own number, and ordinary (non-lead) chatter in your
# own/inhouse groups. Bank groups are locked out at the database level and
# stay that way on purpose — see pipeline/bank.js.
AI_REPLY_ENABLED=false
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional, cosmetic attribution headers sent to OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=WhatsApp Lead Bot
# Turn either of these off independently if you only want one surface
AI_REPLY_IN_DMS=true
AI_REPLY_IN_GROUPS=true
# How many past user+assistant turns to remember per chat (memory is
# in-process only — it resets on restart)
AI_HISTORY_TURNS=6
# Leave blank to use the built-in prompt (instructs it to reply in whatever
# language/script the sender used). Set this to fully replace it.
AI_SYSTEM_PROMPT=
